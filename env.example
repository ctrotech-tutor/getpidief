# PostgreSQL (see docs/DATABASE.md; use a separate database per environment)
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

# Upstash Redis (Required for caching and rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Upstash Redis for Rate Limiting (Optional - can use same as above)
UPSTASH_REDIS_RATE_LIMIT_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_RATE_LIMIT_REST_TOKEN="your-redis-token"

# Email: select exactly one: local, resend, sendgrid, gmail, or brevo.
# local prints message HTML and sensitive links to the server console and works
# only with NODE_ENV=development. Never use real account data on shared logs.
EMAIL_PROVIDER="local"
# Optional for local; use an address verified/authorized by the chosen provider.
# EMAIL_FROM="getpidief <noreply@yourdomain.com>"
# RESEND_API_KEY="..."
# SENDGRID_API_KEY="..."
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="..."
# BREVO_API_KEY="..."
# Verification/reset email links use this URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INNGEST_DEV="1"

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-bucket-name"

# Pusher (for real-time features)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-pusher-cluster"
PUSHER_USE_TLS="true"

# Inngest (for background jobs)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Other services
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# OAuth providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
