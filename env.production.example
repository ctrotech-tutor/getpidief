# PRODUCTION CHECKLIST / TEMPLATE ONLY. Do not commit filled-in credentials.
# Add values individually in Vercel Project > Settings > Environment Variables,
# scoped to Production. Do not overwrite functioning values with placeholders.
# Only NEXT_PUBLIC_ values are exposed to browsers. Do not put secrets there.

# Required: Supabase transaction pooler connection URI, with TLS.
# Use the SESSION pooler URI separately for migration operations, not here.
DATABASE_URL="<SUPABASE_TRANSACTION_POOLER_URI>"

# Canonical public HTTPS URL, used in verification and reset links.
NEXT_PUBLIC_APP_URL="https://www.getpidief.me"
# Optional Auth.js URL override: if set, it must match the canonical deployment.
# AUTH_URL="https://www.getpidief.me"
# Do not set conflicting NEXTAUTH_URL/AUTH_URL values.

# Auth.js: retain your existing strong server secret if already in use.
# Rotating it invalidates existing sessions. Use AUTH_SECRET (or the existing
# NEXTAUTH_SECRET legacy alias), not conflicting values.
AUTH_SECRET="<EXISTING_OR_NEW_RANDOM_AUTH_SECRET>"
GOOGLE_CLIENT_ID="<GOOGLE_WEB_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<GOOGLE_WEB_CLIENT_SECRET>"

# Required for credential signup, verification, reset and production rate limits.
# These are REST credentials; do not put regular redis:// URLs here.
UPSTASH_REDIS_REST_URL="<UPSTASH_MAIN_REST_URL>"
UPSTASH_REDIS_REST_TOKEN="<UPSTASH_MAIN_REST_TOKEN>"
UPSTASH_REDIS_RATE_LIMIT_REST_URL="<UPSTASH_RATE_LIMIT_REST_URL>"
UPSTASH_REDIS_RATE_LIMIT_REST_TOKEN="<UPSTASH_RATE_LIMIT_REST_TOKEN>"

# Required for background jobs and asynchronous verification/reset emails.
INNGEST_EVENT_KEY="<INNGEST_PRODUCTION_EVENT_KEY>"
INNGEST_SIGNING_KEY="<INNGEST_PRODUCTION_SIGNING_KEY>"
# Optional: default is 50s. Do not set INNGEST_DEV=1 in production.
# INNGEST_MAX_RUNTIME="50s"

# Choose ONE verified production email provider. This example uses Resend.
EMAIL_PROVIDER="resend"
EMAIL_FROM="getpidief <noreply@getpidief.me>"
RESEND_API_KEY="<RESEND_API_KEY>"
# Alternatives: EMAIL_PROVIDER=sendgrid + SENDGRID_API_KEY, or brevo +
# BREVO_API_KEY, or gmail + GMAIL_USER and GMAIL_APP_PASSWORD. See docs/EMAIL.md.
# Do not use EMAIL_PROVIDER=local or console in production.

# Optional: choose ONE object storage backend for uploads. Upload/privacy
# settings and existing public URLs need independent security review.
# Backblaze B2 S3-compatible endpoint (full HTTPS URL):
# B2_ENDPOINT="<B2_S3_ENDPOINT>"
# B2_BUCKET_NAME="<B2_BUCKET_NAME>"
# B2_REGION="<B2_REGION>"
# B2_KEY_ID="<B2_KEY_ID>"
# B2_APPLICATION_KEY="<B2_APPLICATION_KEY>"
# B2_PUBLIC_URL="<B2_PUBLIC_BASE_URL>"
# Cloudflare R2 alternative (do not mix B2 and R2 settings):
# CLOUDFLARE_ACCOUNT_ID="<CLOUDFLARE_ACCOUNT_ID>"
# R2_BUCKET_NAME="<R2_BUCKET_NAME>"
# R2_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
# R2_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
# R2_PUBLIC_URL="<R2_PUBLIC_BASE_URL>"

# Optional: Pusher realtime; public key/cluster are intentionally browser-visible.
# PUSHER_APP_ID="<PUSHER_APP_ID>"
# PUSHER_SECRET="<PUSHER_SECRET>"
# NEXT_PUBLIC_PUSHER_KEY="<PUSHER_KEY>"
# NEXT_PUBLIC_PUSHER_CLUSTER="<PUSHER_CLUSTER>"

# Optional observability. Public values are visible to visitors.
# NEXT_PUBLIC_POSTHOG_KEY="<POSTHOG_PUBLIC_PROJECT_KEY>"
# NEXT_PUBLIC_POSTHOG_HOST="<POSTHOG_HOST>"
# NEXT_PUBLIC_SENTRY_DSN="<SENTRY_PUBLIC_DSN>"
# SENTRY_AUTH_TOKEN="<SENTRY_BUILD_TOKEN>"
